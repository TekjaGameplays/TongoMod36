		<action_sequence name="tm_horde_template">
			<property name="action_type" value="Game"/>
			<property name="allow_while_dead" value="false"/>
			
			<action class="SpawnEntity">
				<property name="entity_names" value="zombieArleneIrradiationComand,zombieScreamerIrradiation,zombieSpiderInfernalIrradiation,zombieArleneElectricComand,zombieScreamerElectric,zombieSpiderInfernalElectric,zombieArleneFireComand,zombieScreamerFire,zombieSpiderInfernalFire" param1="entity"/>
				<property name="spawn_count" value="4" param1="count"/>
				<property name="air_spawn" value="false"/>
				<property name="add_to_group" value="zombies"/>
				<property name="safe_spawn" value="true"/>
				<property name="min_distance" value="15"/>
				<property name="max_distance" value="20"/>
				<property name="spawn_type" value="WanderingHorde" />
			</action>			
			
			<action class="PlaySound">
				<property name="sound" value="horde_spawn_warning"/>
				<property name="phase" value="0"/>
			</action>
			
			<action class="BeltTooltip">
				<property name="text_key" value="ScoutHordeE" />
				<property name="phase" value="0"/>
			</action>
		</action_sequence>
		
