	<append xpath="/buffs">


		<!-- call event to remove zombie (llama al evento que elimina al zombi) -->
		<buff name="buffRemoveZombieTM" name_key="buffRemoveZombieTMName" description_key="buffRemoveZombieTMDesc" tooltip_key="buffRemoveZombieTMDesc" icon="ui_game_symbol_fire" icon_color="255,0,0" icon_blink="true">
			<stack_type value="ignore"/>
			<duration value="0.1"/>
			<update_rate value="0.1"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="CallGameEvent" event="removeZombieTM"/>
			</effect_group>

		</buff>

		<!-- easy mode (modo facil) -->
		<buff name="buffEasyModeTM" name_key="buffEasyModeTMName" description_key="buffEasyModeTMDesc" icon="ui_game_symbol_chikenTM" icon_color="250,250,50" remove_on_death="false">
			<stack_type value="ignore"/>
			<display_value_key value="buffEasyModeTMNameShort"/>
			<display_value value="xxx"/>
			
			<effect_group>
				<!-- added effect activate buff only on the specified zombies within range. -->
				<!-- se añade activa el bufo solo en los zombis indicados dentro del rango -->
				<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" target="selfAOE" range="30" buff="buffRemoveZombieTM">
					<requirement name="!EntityTagCompare" target="other" tags="npc,vehicle,player,turret,drone"/>
					<requirement name="EntityTagCompare" target="other" tags="zombieTM"/>
				</triggered_effect>
			</effect_group>
		</buff>

		
		<!--  hard mode (modo dificil) -->
		<buff name="buffHardModeTM" name_key="buffHardModeTMName" description_key="buffHardModeTMDesc" icon="ui_game_symbol_demonTM" icon_color="255,0,0" remove_on_death="false">
			<stack_type value="ignore"/>
			<display_value_key value="buffHardModeTMNameShort"/>
			<display_value value="xxx"/>

			<effect_group>
				<!-- added effect activate buff only on the specified zombies within range. -->
				<!-- se añade activa el bufo solo en los zombis indicados dentro del rango -->
				<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" target="selfAOE" range="30" buff="buffHardZombieTM">
					<requirement name="!EntityTagCompare" target="other" tags="npc,vehicle,player,turret,drone"/>
					<requirement name="EntityTagCompare" target="other"	tags="zombieTM"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- hard mode effect 1 "zombie gain HP" (modo dificil efecto 1 "aumento HP zombi") -->
		<!-- revisar no funciona bien -->
		<buff name="buffHardZombieTM" hidden="true">
			<stack_type value="ignore"/>
			<duration value="2"/>

			<effect_group name="Hard Mode">
			</effect_group>

		</buff>

		
		

